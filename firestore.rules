rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.secure_session == true
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/security_accounts/$(request.auth.uid)).data.blocked == false
        && request.auth.token.security_version == get(/databases/$(database)/documents/security_accounts/$(request.auth.uid)).data.version;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'ADMIN';
    }

    function isTeacher() {
      return signedIn() && userRole() == 'TEACHER';
    }

    function teacherInvitationExists(email) {
      return exists(/databases/$(database)/documents/allowed_teachers/$(email))
        && get(/databases/$(database)/documents/allowed_teachers/$(email)).data.email == email;
    }

    match /pending_profiles/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email.matches('^[^@]+@(pnu\\.edu\\.ua|stefanyk\\.edu\\.ua)$')
        && (
          request.resource.data.role == 'STUDENT'
          || (request.resource.data.role == 'TEACHER' && teacherInvitationExists(request.auth.token.email))
        );
      allow get: if signedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
      allow delete: if signedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email.matches('^[^@]+@(pnu\\.edu\\.ua|stefanyk\\.edu\\.ua)$')
        && (
          request.resource.data.role == 'STUDENT'
          || (request.resource.data.role == 'TEACHER' && teacherInvitationExists(request.auth.token.email))
        );
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();

      match /favorites/{materialId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /completed/{materialId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /allowed_teachers/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.email == email;
      allow delete: if isAdmin();
    }

    match /presence/{userId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == userId && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasOnly(['lastSeen', 'sentAt'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.sentAt is timestamp
        && request.resource.data.sentAt >= request.time - duration.value(2, 'm')
        && request.resource.data.sentAt <= request.time + duration.value(2, 'm');
    }

    match /system_metrics/{metricId} {
      allow read: if isAdmin();
    }

    match /{path=**}/activity/{eventId} {
      allow read: if isAdmin();
    }

    match /system_alerts/{alertId} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['text', 'level', 'active', 'authorId', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.level in ['INFO', 'MAINTENANCE', 'EMERGENCY']
        && request.resource.data.active == true
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email_verified == true
        && (isAdmin() || isTeacher())
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'materialId', 'subject', 'text', 'createdAt', 'scope', 'materialTitle'])
        && request.resource.data.scope in ['SUBJECT', 'MATERIAL']
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
        && request.resource.data.materialId is string
        && exists(/databases/$(database)/documents/materials/$(request.resource.data.materialId))
        && (isAdmin() || get(/databases/$(database)/documents/materials/$(request.resource.data.materialId)).data.teacherId == request.auth.uid)
        && request.resource.data.subject == get(/databases/$(database)/documents/materials/$(request.resource.data.materialId)).data.subject
        && request.resource.data.materialTitle == get(/databases/$(database)/documents/materials/$(request.resource.data.materialId)).data.title
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (isTeacher() && resource.data.authorId == request.auth.uid);
    }

    match /materials/{materialId} {
      function ownsMaterial() {
        return isAdmin() || (isTeacher() && get(/databases/$(database)/documents/materials/$(materialId)).data.teacherId == request.auth.uid);
      }
      match /analytics/{settingId} {
        allow read: if ownsMaterial();
        allow create, update: if ownsMaterial() && settingId == 'settings'
          && request.resource.data.keys().hasOnly(['group', 'groupSize', 'deadline'])
          && request.resource.data.group is string && request.resource.data.group.size() <= 100
          && request.resource.data.groupSize is int && request.resource.data.groupSize >= 0 && request.resource.data.groupSize <= 10000
          && request.resource.data.deadline is int && request.resource.data.deadline >= 0;
      }
      match /activity/{eventId} {
        allow read: if ownsMaterial();
        allow create: if signedIn() && request.auth.token.email_verified == true && userRole() == 'STUDENT'
          && exists(/databases/$(database)/documents/materials/$(materialId))
          && request.resource.data.keys().hasOnly(['studentId', 'kind', 'group', 'time'])
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.kind in ['VIEW', 'DOWNLOAD']
          && request.resource.data.group == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('group', '')
          && request.resource.data.time == request.time;
      }
      match /reactions/{studentId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == studentId
          && request.auth.token.email_verified == true
          && userRole() == 'STUDENT'
          && exists(/databases/$(database)/documents/materials/$(materialId))
          && request.resource.data.keys().hasOnly(['reaction'])
          && request.resource.data.reaction in ['FIRE', 'DIFFICULT', 'CLEAR', 'QUESTION'];
        allow delete: if signedIn() && request.auth.uid == studentId && userRole() == 'STUDENT';
      }
      allow read: if signedIn();
      allow create: if isAdmin() || (
        isTeacher() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isTeacher()
        && resource.data.teacherId == request.auth.uid
        && (request.method == 'delete' || request.resource.data.teacherId == resource.data.teacherId)
      );
    }
  }
}
